/*
  Force fresh loads for the shell and all static app assets so browsers do not
  keep serving stale icons, fonts, and JavaScript after a new deploy.
*/
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate
/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate
/main.dart.js
  Cache-Control: no-cache, no-store, must-revalidate
/*.js
  Cache-Control: no-cache, no-store, must-revalidate
/*.css
  Cache-Control: no-cache, no-store, must-revalidate
/*.png
  Cache-Control: no-cache, no-store, must-revalidate
/*.svg
  Cache-Control: no-cache, no-store, must-revalidate
/*.ico
  Cache-Control: no-cache, no-store, must-revalidate
/assets/*
  Cache-Control: no-cache, no-store, must-revalidate
/assets/fonts/*.otf
  Content-Type: font/otf
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache, no-store, must-revalidate
/*.otf
  Content-Type: font/otf
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache, no-store, must-revalidate
